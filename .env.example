# ============ 飞书（必填：用于接收你的消息） ============
# 开发者后台 https://open.feishu.cn → 你的应用 → 凭据与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 触发方式：all = 机器人收到的任何文字都发布（默认）
#           prefix = 消息必须以 TRIGGER_PREFIX 开头才会发布
TRIGGER_MODE=all
TRIGGER_PREFIX=/发

# 调试事件结构（排查收不到消息时设为 1）
# DEBUG_EVENT=1

# ============ 微博（Cookie 模式） ============
# 浏览器登录 m.weibo.cn 后，从 F12 → 网络 → 请求标头复制整串 Cookie
# 至少需包含 SUB、SUBP、SCF；XSRF-TOKEN 服务会自动取最新的，无需手动维护
WEIBO_MODE=cookie
WEIBO_COOKIE=
# 官方 API 模式（可选，需要开放平台应用的发博权限）：
# WEIBO_MODE=api
# WEIBO_ACCESS_TOKEN=

# ============ 即刻（非官方接口） ============
# 浏览器登录 web.okjike.com → F12 Console 依次执行：
#   localStorage.getItem("JK_ACCESS_TOKEN")
#   localStorage.getItem("JK_REFRESH_TOKEN")
# access token 约 30 分钟过期，服务会用 refresh token 自动续期并写回本文件
JIKE_ACCESS_TOKEN=
JIKE_REFRESH_TOKEN=

# ============ 豆瓣（非官方接口） ============
# 浏览器登录 www.douban.com 后的完整 Cookie（需含 ck=xxx）
# 注意 dbcl2 是 httpOnly 字段，document.cookie 取不到，
# 需从 F12 → 网络 → 请求标头里复制整行 Cookie
DOUBAN_COOKIE=
